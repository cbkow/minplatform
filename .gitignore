/target/
**/target/
.DS_Store
*.swp
/docs/spikes/**/out/
/fixtures/
# anything a spike or tool records: traces, logs, screenshots, media
*.trace
*.mov
*.mp4
*.mxf
*.exr
*.png
!packaging/windows/msix/images/*.png
!packaging/windows/msix-minnotes/images/*.png
!packaging/windows/msix-minrender/Assets/*.png
# the application's icon and the User Guide's pictures (synthetic demo) are part of the build
!apps/mn/assets/icons/*.png
!apps/mr/assets/icons/*.png
!apps/mn/guide/images/*.png

# the pinned FFmpeg binaries (tools/ffmpeg/fetch-win64.ps1) — never committed
external/ffmpeg/
external/deps/
external/sparkle/
external/dxc/
# the app's own icons (QCView's brand mark for exports) — not fixtures
!apps/qcv/assets/icons/*.png
# UFB's built-in project type: the applications' own template files (a Blender, an After Effects and a Premiere project)
# are kept out until the owner says they go in as they are - the folders are tracked, the files are copied in locally
apps/ufb/resources/types/*/skeletons/**/*.blend
apps/ufb/resources/types/*/skeletons/**/*.aep
apps/ufb/resources/types/*/skeletons/**/*.prproj
