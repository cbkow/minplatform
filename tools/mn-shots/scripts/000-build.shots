# builds the demo collection (run on a new, empty collection: `run.sh build` does that)
size 1280 800
wait 1
# the new collection's first note
click 700 130
type Inbox
key Enter
type Loose thoughts land here first and are moved to their note later.
key Enter
type Ask Jonas about the boat rig
key Enter
type Find a second reference for the workshop interior
import ${MN_DEMO_DIR}/Notes/Welcome.md
wait 1.5
menu NewFolder
type Production
key Enter
wait 0.3
import ${MN_DEMO_DIR}/Notes/Schedule.md|${MN_DEMO_DIR}/Notes/Review - Reel 2.md|${MN_DEMO_DIR}/Notes/Delivery specs.md|${MN_DEMO_DIR}/Notes/Look references.md
wait 3
note Review - Reel 2
wait 0.5
add @2 ${MN_DEMO_DIR}/Media/Reel 2 - harbour v003.mp4
wait 2
add ${MN_DEMO_DIR}/Media/Reel 2 - harbour v002.mp4
wait 2
# notes and drawings on the clip: it is played and paused, taken to a frame on its bar, drawn on, and a note typed
key cmd+Up
wait 0.5
click 700 400
wait 0.5
key Space
wait 0.3
click 560 693
wait 0.6
click 360 16
down 620 560
move 700 500
move 780 440
up 800 420
wait 0.3
click 488 16
wait 0.3
type Too dark in this corner
key Enter
wait 0.5
click 800 724
wait 0.6
click 392 16
down 900 300
move 1000 380
up 1100 430
wait 0.3
click 488 16
wait 0.3
type Hold the lantern glow two frames longer
key Enter
wait 0.5
click 1010 724
wait 0.6
click 488 16
wait 0.3
type Horizon drifts in the last second
key Enter
wait 0.5
click 264 16
shot build-review
note Delivery specs
wait 0.5
add @2 ${MN_DEMO_DIR}/Media/Delivery spec.pdf
wait 2
add ${MN_DEMO_DIR}/Media/Budget.xlsx|${MN_DEMO_DIR}/Media/Temp score.wav
wait 2
shot build-specs
# the meetings folder (made at the top level: the selection is a top-level note)
note Welcome
wait 0.5
menu NewFolder
type Meetings
key Enter
wait 0.3
import ${MN_DEMO_DIR}/Notes/Kickoff.md|${MN_DEMO_DIR}/Notes/Colour session.md
wait 2
# the canvas: the sidebar's New canvas button, named, then pictures dropped on it
click 80 82
wait 0.5
click 180 24
wait 0.5
menu Rename
wait 0.2
type Moodboard
key Enter
wait 0.3
add ${MN_DEMO_DIR}/Media/Lantern study 01.png|${MN_DEMO_DIR}/Media/Lantern study 02.png|${MN_DEMO_DIR}/Media/Night key.jpg|${MN_DEMO_DIR}/Media/Harbour palette.png|${MN_DEMO_DIR}/Media/Texture pass.png|${MN_DEMO_DIR}/Media/Layout sketch.png
wait 2.5
# arranged as two rows of three (the cards are dragged), a note of the canvas's own, an arrow; then everything in view
click 900 650
down 839 400
move 700 450
move 400 500
up 363 500
down 998 400
move 800 450
up 522 500
down 1156 400
move 900 450
up 680 500
wait 0.3
click 1252 739
wait 0.8
dclick 420 640
wait 0.6
type Warm against cool
key Enter
type The lanterns are the only warm light in the film.
wait 0.3
key Escape
wait 0.3
click 1252 739
wait 0.8
shot build-canvas
note Welcome
wait 1
shot build-welcome
menu Save
wait 1
quit
