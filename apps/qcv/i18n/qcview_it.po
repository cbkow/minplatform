msgid "%1 is streaming on port %2 — select the Blender clip"
msgstr "%1 sta trasmettendo sulla porta %2 — seleziona la clip Blender"

#. Blender input state
msgctxt "LeftRail"
msgid "Blender session ended"
msgstr "Sessione Blender terminata"

#. Blender input state: no card yet
msgctxt "LeftRail"
msgid "No Blender session on this machine yet"
msgstr "Ancora nessuna sessione Blender su questa macchina"

#. Audio/video offset setting for bridge feeds
msgctxt "LeftRail"
msgid "A/V sync (Live)"
