msgid "Settings"
msgstr "Настройки"

msgctxt "LeftRail"
msgid "Reset all preferences?"
msgstr "Сбросить все настройки?"

msgctxt "LeftRail"
msgid "Every preference (recents, layout, settings, shortcuts) will be erased and the app will quit. Relaunch to continue."
msgstr "Все настройки (недавние, раскладка, параметры, сочетания клавиш) будут стёрты, и приложение закроется. Запустите его снова, чтобы продолжить."

#. Settings group header
msgctxt "LeftRail"
msgid "Performance"
msgstr "Производительность"

#. Image-seq = image sequence
msgctxt "LeftRail"
msgid "Image-seq decode threads"
msgstr "Потоки декодирования секв."

msgctxt "LeftRail"
msgid "Applies on next sequence load."
msgstr "Применяется при следующей загрузке секвенции."

#. Image-seq = image sequence
msgctxt "LeftRail"
msgid "Image-seq cache window"
msgstr "Окно кэша секв."

msgctxt "LeftRail"
msgid "Frames cached ahead of the playhead. Lower = less RAM."
msgstr "Сколько кадров кэшируется впереди курсора воспроизведения. Меньше = меньше ОЗУ."

msgctxt "LeftRail"
msgid "Video decode threads"
msgstr "Потоки декодирования видео"

msgctxt "LeftRail"
msgid "0 = Auto. Single-video playback only; dual and scrub stay on Auto. Applies on next video load."
msgstr "0 = авто. Только для одиночного видео; двойной просмотр и скраббинг остаются на авто. Применяется при следующей загрузке видео."

msgctxt "LeftRail"
msgid "Enable hardware decoding"
msgstr "Аппаратное декодирование"

msgctxt "LeftRail"
msgid "GPU decode (Vulkan/D3D11VA) when available. Turn off if playback misbehaves — forces software decode everywhere. Applies on next file load."
msgstr "Декодирование на GPU (Vulkan/D3D11VA), когда доступно. Выключите, если воспроизведение сбоит — везде будет программное декодирование. Применяется при следующей загрузке файла."

msgctxt "LeftRail"
msgid "Scrub cache size (MB)"
msgstr "Размер кэша скраббинга (МБ)"

msgctxt "LeftRail"
msgid "Decoded frames kept near the playhead for instant backward scrub. Higher = smoother, more RAM/VRAM. Per decoder — dual uses 2x. Applies on next file load."
msgstr "Декодированные кадры около курсора воспроизведения для мгновенного скраббинга назад. Больше = плавнее, но больше ОЗУ/VRAM. На каждый декодер — двойной просмотр берёт 2x. Применяется при следующей загрузке файла."

msgctxt "LeftRail"
msgid "Hardware scrub for h264/h265 (experimental)"
msgstr "Аппаратный скраббинг h264/h265 (экспериментально)"

msgctxt "LeftRail"
msgid "GPU decode while scrubbing h264/h265, not just all-intra (ProRes). Experimental — turn off if scrubbed frames look wrong. Applies on next file load."
msgstr "Декодирование на GPU при скраббинге h264/h265, а не только all-intra (ProRes). Экспериментально — выключите, если кадры при скраббинге выглядят неверно. Применяется при следующей загрузке файла."

