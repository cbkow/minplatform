<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- QCView's application manifest (QCView-Player packaging/windows/qcview.manifest): longPathAware opts the process out of
     the 260-character path limit (deep image-sequence folders); the machine's LongPathsEnabled policy must also be on. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
