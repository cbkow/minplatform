<?xml version="1.0" encoding="utf-8"?>
<!-- The Store package's manifest of minNotes (canon row 379): minNotes 2.x's identity, file types and protocol as its
     own manifest had them, so the Store replaces 2.x in place. make-msix-minnotes.ps1 fills @VERSION@ (apps/mn/Cargo.toml,
     four parts). runFullTrust is the only capability: what minNotes writes under AppData is private to it. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="cbkow.minNotes"
    Version="@VERSION@"
    Publisher="CN=C64A1D41-EFAA-4EED-AE81-0C074867D4E9"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>minNotes</DisplayName>
    <PublisherDisplayName>cbkow</PublisherDisplayName>
    <Logo>images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="minNotes" Executable="minNotes.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="minNotes"
        Description="Notes for people who work with footage: text, tables, media and review notes"
        BackgroundColor="transparent"
        Square150x150Logo="images\Square150x150Logo.png"
        Square44x44Logo="images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="images\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="minnotesdocument">
            <uap:DisplayName>minNotes Document</uap:DisplayName>
            <uap:Logo>images\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.mnd</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="minnotespackage">
            <uap:DisplayName>minNotes Package</uap:DisplayName>
            <uap:Logo>images\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.mnpkg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="minnotes">
            <uap:DisplayName>minNotes Link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
